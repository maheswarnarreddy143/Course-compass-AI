# CourseCompass AI Environment Configuration

# Groq API Key (Fastest LLM Inference - https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini API Key (Optional, from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API Key (Optional, from https://platform.openai.com/)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Ollama Local LLM (Optional, free local AI from https://ollama.ai/)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Chunking & Retrieval
CHUNK_SIZE=600
CHUNK_OVERLAP=120
TOP_K_RETRIEVAL=4
